# iPusnas Credentials
IPUSNAS_EMAIL=your_email@example.com
IPUSNAS_PASSWORD=your_password

# Configuration
# Path to save downloaded books (default: ./downloads)
IPUSNAS_OUTPUT_DIR=/path/to/downloads
# Path to QPDF binary (default: qpdf in PATH, then bin/qpdf)
QPDF_PATH=/usr/bin/qpdf
# Path to the session config file (default: ./config.json)
# IPUSNAS_CONFIG=/path/to/config.json
